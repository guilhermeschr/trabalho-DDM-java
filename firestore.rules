rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validName(value) { return value is string && value.size() > 0 && value.matches('.*[^ ].*'); }
    match /usuarios/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['nome', 'perfil', 'criadoEm'])
        && validName(request.resource.data.nome)
        && request.resource.data.perfil in ['COMUM', 'PONTO_COLETA']
        && request.resource.data.criadoEm == request.time
        && (request.resource.data.perfil == 'COMUM'
          || getAfter(/databases/$(database)/documents/pontosColeta/$(uid)).data.responsavelUid == uid);
      allow update, delete: if false;
    }
    match /pontosColeta/{uid} {
      allow read: if request.auth != null;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['responsavelUid', 'nome', 'endereco', 'latitude', 'longitude', 'criadoEm'])
        && request.resource.data.responsavelUid == uid
        && validName(request.resource.data.nome)
        && validName(request.resource.data.endereco)
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.criadoEm == request.time
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.perfil == 'PONTO_COLETA'
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.nome == request.resource.data.nome;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
