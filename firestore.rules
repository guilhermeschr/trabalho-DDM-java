rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validName(value) { return value is string && value.size() > 0 && value.matches('.*[^ ].*'); }
    match /usuarios/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['nome', 'perfil', 'criadoEm'])
        && validName(request.resource.data.nome)
        && request.resource.data.perfil in ['COMUM', 'PONTO_COLETA']
        && request.resource.data.criadoEm == request.time
        && (request.resource.data.perfil == 'COMUM'
          || getAfter(/databases/$(database)/documents/pontosColeta/$(uid)).data.responsavelUid == uid);
      allow update, delete: if false;
    }
    match /pontosColeta/{uid} {
      allow read: if request.auth != null;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['responsavelUid', 'nome', 'endereco', 'latitude', 'longitude', 'criadoEm'])
        && request.resource.data.responsavelUid == uid
        && validName(request.resource.data.nome)
        && validName(request.resource.data.endereco)
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.criadoEm == request.time
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.perfil == 'PONTO_COLETA'
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.nome == request.resource.data.nome;
      allow update, delete: if false;
    }
    match /objetos/{id} {
      function signedIn() { return request.auth != null; }
      function commonUser() {
        return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'COMUM';
      }
      function validText(value) { return value is string && value.size() > 0 && value.matches('(?s).*\\S.*'); }
      allow list: if signedIn() && resource.data.situacao == 'DISPONIVEL';
      // A leitura de ID ausente permite a transação de criação sem escrita offline.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/objetos/$(id)) || resource.data.situacao == 'DISPONIVEL');
      allow create: if commonUser()
        && request.resource.data.keys().hasAll(['nome', 'descricao', 'localAproximado', 'latitude', 'longitude', 'pontoId', 'autorUid', 'situacao', 'fotos', 'criadoEm'])
        && request.resource.data.keys().hasOnly(['nome', 'descricao', 'localAproximado', 'latitude', 'longitude', 'pontoId', 'autorUid', 'situacao', 'fotos', 'criadoEm'])
        && validText(request.resource.data.nome)
        && validText(request.resource.data.descricao)
        && validText(request.resource.data.localAproximado)
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.pontoId is string
        && exists(/databases/$(database)/documents/pontosColeta/$(request.resource.data.pontoId))
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.situacao == 'DISPONIVEL'
        && request.resource.data.fotos is list && request.resource.data.fotos.size() == 0
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
